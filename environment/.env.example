# ==============================================================================
# Database Configuration (PostgreSQL / Supabase)
# ==============================================================================
DATABASE_URL="postgresql://postgres:your-password@your-host:5432/postgres"

# ==============================================================================
# Web Server & Deployment Settings (Render Standard)
# ==============================================================================
# Port listened by web server (Default: 10000)
PORT=10000

# Pipeline execution interval in seconds (Default: 60)
PIPELINE_INTERVAL_SECONDS=60

# ==============================================================================
# Selenium & Chromium Paths (Auto-configured in Docker image)
# ==============================================================================
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
# CHROME_BIN=/usr/bin/chromium
